; CSE 135 — database credentials.
;
; Reference copy of the shape only. The real file lives at /etc/cse135/db.ini on
; the droplet — NOT in the repo and NOT under any document root.
;
; This file is never deployed (deploy.yml syncs only sites/ and src/sql/), so
; write the real one directly on the droplet rather than copying it up; that also
; keeps the password out of /tmp. See docs/guides/hw3-part4-database-setup.md.
;
; 640 root:www-data => Apache (www-data) can read it, nobody else can, and it is
; never reachable over HTTP.

host = 127.0.0.1
port = 3306
name = cse135
user = cse135_app
pass = CHANGE_ME
