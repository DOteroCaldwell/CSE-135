# HW4 — reporting.ucsdwrestlingclub.com (:443)
#
# Hosts the REST API (/api), the analytics dashboard, and the detailed report.
# Merge into the certbot-generated -le-ssl.conf; do not overwrite it.
#
# ---------------------------------------------------------------------------
# WHAT CHANGED IN HW4, AND THE ORDER IT MUST CHANGE IN
# ---------------------------------------------------------------------------
#
# Through HW3 this vhost kept HW1's blanket `Require valid-user` over everything,
# and that was the ONLY thing protecting /api. HW4 has to remove it: a login form
# sitting behind HTTP Basic is a login form nobody can reach, and the assignment
# requires an application login.
#
# The moment that directive comes off, an unguarded /api/* would serve the entire
# analytics database to anonymous callers. So the application grew its own guard
# first (sites/reporting/api/index.php -> requireApiAuth()), which accepts either
# a dashboard session cookie or HTTP Basic checked against the `users` table.
#
#   DEPLOY IN THIS ORDER:
#     1. Deploy the application code (it still works fine behind Basic).
#     2. Verify:  curl -u grader-admin:... https://reporting.../api/static  -> 200
#                 and that the app's own login page renders.
#     3. THEN apply this config and reload Apache.
#     4. Re-verify anonymously:  curl https://reporting.../api/static  -> 401
#                                curl https://reporting.../          -> 302 to /login.php
#
# Doing it in the other order leaves a window where the API is public.
# ---------------------------------------------------------------------------

<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName reporting.ucsdwrestlingclub.com
    ServerAdmin clubwrestling@ucsd.edu
    DocumentRoot /var/www/reporting.ucsdwrestlingclub.com

    ErrorLog  ${APACHE_LOG_DIR}/reporting_error.log
    LogLevel  warn
    CustomLog ${APACHE_LOG_DIR}/reporting_access.log combined_ch

    # index.php is the dashboard. Ubuntu's default DirectoryIndex lists index.html
    # FIRST, so leaving a stale index.html in the web root would shadow the whole
    # application and serve the old HW1 placeholder instead. The HW1 stub has been
    # deleted from the repo; this makes the intent explicit regardless.
    DirectoryIndex index.php index.html

    <Directory "/var/www/reporting.ucsdwrestlingclub.com">
        Options -Indexes +FollowSymLinks
        AllowOverride All

        # Authentication is now the application's job — see the header above.
        Require all granted

        # php-fpm does not receive the Authorization header unless it is passed
        # explicitly. Without this, HTTP Basic against /api silently never
        # authenticates: PHP_AUTH_USER is unset, the guard sees no credentials, and
        # `curl -u` gets a 401 no matter what password is supplied.
        # Apache 2.4.13+.
        CGIPassAuth On
    </Directory>

    # Application code, not web content. The deploy rsyncs sites/reporting/ into
    # the web root wholesale, so app/ lands under DocumentRoot whether or not that
    # was intended. It carries its own .htaccess saying the same thing; this is the
    # copy that does not depend on AllowOverride still being set.
    <Directory "/var/www/reporting.ucsdwrestlingclub.com/app">
        Require all denied
    </Directory>

    # ---- REST routing ----
    # Everything under /api that is not a real file goes to the front controller.
    #
    # Two things this deliberately does NOT do:
    #
    #  1. It does not append the matched path ($1) to the target. Rewriting to
    #     /api/index.php/static would make Apache hand php-fpm a PATH_INFO it
    #     often cannot split, producing "Primary script unknown" 404s. The router
    #     reads REQUEST_URI instead, which Apache leaves as the ORIGINAL request
    #     path across an internal rewrite. Verified against Apache 2.4:
    #     GET /api/static/5?limit=2 reaches the script with
    #     REQUEST_URI=/api/static/5 and QUERY_STRING=limit=2.
    #
    #  2. It does not need a loop guard. index.php is a real file, so !-f is
    #     false for it and the rule simply does not apply.
    RewriteEngine on
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^/api(/.*)?$ /api/index.php [QSA,L]

    # Compression. A dashboard about page weight should not ship uncompressed.
    <IfModule mod_deflate.c>
        AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
    </IfModule>

    Include /etc/letsencrypt/options-ssl-apache.conf
    SSLCertificateFile    /etc/letsencrypt/live/ucsdwrestlingclub.com/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/ucsdwrestlingclub.com/privkey.pem
</VirtualHost>
</IfModule>
