# Secrets / credentials — never commit
*.pem
*.key
deploy_key*
.env
.env.*
!.env.example

# Private submission notes (grader credentials, write-ups)
docs/writeups/

# Dependencies
node_modules/
vendor/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Build / logs / temp
dist/
build/
*.log
tmp/

# HW2 build artifacts — Go CGI binaries are compiled in CI, not committed
sites/main/hw2/go/*.cgi
__pycache__/
*.pyc

# DB credentials — only the .example template is tracked
db.ini
